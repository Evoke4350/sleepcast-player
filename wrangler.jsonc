{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleepcast",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Workers rate limiting for /api/relay: opening the app fetches every
  // subscribed feed at once, so the ceiling clears a full library in one
  // burst, but nothing beyond that.
  "ratelimits": [
    { "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  // Custom domains: Cloudflare makes their DNS records and certificates.
  "routes": [
    { "pattern": "sleepcast.pro", "custom_domain": true },
    { "pattern": "www.sleepcast.pro", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
