---
import "../styles/globals.css";

export interface Props {
  title?: string;
}

const { title = "sleepcast" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f12" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Installed to a homescreen, this is opened in the dark and held at
         arm's length. Standalone display and a translucent status bar keep the
         browser chrome from lighting up the room. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="sleepcast" />
    <meta name="mobile-web-app-capable" content="yes" />
  </head>
  <body class="min-h-full flex flex-col">
    <slot />
    <div id="sc-consent" hidden role="dialog" aria-label="analytics consent"
      class="fixed inset-x-0 bottom-0 z-50 border-t border-[var(--line)] bg-[var(--surface)]/95 px-4 py-3 text-xs text-[var(--ink-3)] backdrop-blur">
      <div class="mx-auto flex max-w-2xl flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <span>sleepcast uses google analytics to understand usage. <a href="/privacy" class="underline text-[var(--ink)]">learn more</a>.</span>
        <span class="flex gap-2">
          <button id="sc-decline" class="rounded-md border border-[var(--line)] px-3 py-1.5 text-[var(--ink-3)] hover:text-[var(--ink-2)]">decline</button>
          <button id="sc-accept" class="rounded-md border border-[var(--ink-4)] px-3 py-1.5 text-[var(--ink)] hover:border-[var(--ink-2)]">accept</button>
        </span>
      </div>
    </div>
    <script>
      // Analytics only after an accept (lib/analytics.ts). Processed by
      // Astro, like the worker's below, so the CSP lets it run.
      import { initConsent } from "../lib/analytics";
      initConsent();
    </script>
    <!-- Not is:inline: Astro's CSP hashes only the scripts it processes, and
         an is:inline one is blocked, so the worker never registered. -->
    <script>
      // Registered late and failure-tolerant: the player works without it, so
      // a service worker that won't install must never block a night.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
